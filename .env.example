# ===================================================
# CONFIGURACIÓN DE SANITY CMS (Panel de Administración)
# ===================================================
# Podés crear un proyecto gratuito en https://sanity.io (login con Google o GitHub)
# Creá un dataset "production" y copiá acá tu Project ID:
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ===================================================
# CONFIGURACIÓN GENERAL DE LA TIENDA
# ===================================================
# Número de WhatsApp por defecto (código de país sin signos ni ceros)
# Ejemplo para Argentina (+54 9 11 1234-5678): 5491112345678
NEXT_PUBLIC_WHATSAPP_NUMBER=5491112345678

# Título por defecto
NEXT_PUBLIC_STORE_TITLE="Venta de Cosas Personales"

